        "routing": {
          "type": "object",
          "properties": {
            "implement": {
              "type": "string"
            },
            "spec": {
              "type": "string"
            },
            "triage": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "sla": {
          "type": "object",
          "properties": {
            "inReviewMinutes": {
              "type": "number"
            },
            "needsInputMinutes": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "telemetry": {
          "type": "object",
