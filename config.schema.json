                },
                "additionalProperties": false
              },
              "scheduling": {
                "type": "object",
                "properties": {
                  "activeCycleOnly": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              },
              "sla": {
                "type": "object",
                "properties": {
                  "inReviewMinutes": {
                    "type": "number"
                  },
                  "needsInputMinutes": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              },
              "telemetry": {
                "type": "object",
