              "qualityGate": {
                "type": "object",
                "properties": {
                  "commands": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "maxRework": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "baselineTestGlobs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
