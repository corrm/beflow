              "plane_project_id": {
                "type": "string"
              },
              "policy": {
                "type": "object",
                "properties": {
                  "evaluator": {
                    "type": "string",
                    "enum": ["globs", "command", "agentowners", "off"]
                  },
                  "command": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "rules": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "paths": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "agent": {
                          "type": "string"
                        },
                        "decision": {
                          "type": "string",
                          "enum": ["block", "require_approval", "allow"]
