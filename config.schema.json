              "runMode": {
                "type": "string",
                "enum": ["autonomous", "supervised"]
              },
              "ci": {
                "type": "object",
                "properties": {
                  "autoReworkOnRed": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              },
              "deadLetter": {
                "type": "object",
                "properties": {
                  "maxAttempts": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              },
              "inputQuality": {
                "type": "object",
                "properties": {
                  "minBodyChars": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              },
              "limits": {
                "type": "object",
                "properties": {
                  "inReview": {
                    "type": "number"
