            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "agent": {
                    "type": "string"
                  },
                  "decision": {
                    "type": "string",
                    "enum": ["block", "require_approval", "allow"]
