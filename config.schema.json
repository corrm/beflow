              "repos": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "review": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "postToPr": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              },
              "root": {
                "type": "string"
              },
              "routing": {
                "type": "object",
                "properties": {
                  "implement": {
                    "type": "string"
